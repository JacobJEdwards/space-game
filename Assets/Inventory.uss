.container {
    flex-grow: 1;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.inventory {
    flex-grow: 1;
    max-width: 80%;
    max-height: 90%;
    width: 80%;
    height: 90%;
    background-color: rgb(28, 32, 36);
    border-top-color: rgb(255, 197, 0);
    border-top-width: 5px;
    padding: 20px;
}

.header {
    flex-grow: 0;
    font-size: 32px;
    color: rgb(255, 197, 0);
    border-bottom-color: rgb(64, 74, 82);
    border-bottom-width: 2px;
    margin-bottom: 20px;
    padding-bottom: 10px;
}

.equipmentContainer {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 30px;
    padding: 15px;
    background-color: rgba(9, 19, 21, 0.5);
    border-radius: 8px;
}

.equipmentSlot {
    width: 225px;
    height: 225px;
    background-color: rgb(9, 19, 21);
    border-radius: 8px;
    padding: 15px;
    align-items: center;
    margin: 0 20px;
}

.equipmentLabel {
    color: rgb(255, 197, 0);
    font-size: 24px;
    margin-bottom: 10px;
}

.equipmentImage {
    width: 50%;
    height: 60%;
    background-color: rgba(48, 48, 48, 0.5);
    border-radius: 5px;
    margin: 10px;
}

.equipmentName {
    color: white;
    font-size: 20px;
    margin-top: 10px;
}

/* New upgrade button styles */
.upgradeButton {
    background-color: rgb(47, 92, 48);
    border-radius: 5px;
    padding: 5px 10px;
    color: white;
    font-size: 16px;
    margin-top: 10px;
    align-self: center;
    transition: all 0.2s;
}

.upgradeButton:hover {
    background-color: rgb(72, 133, 73);
    scale: 1.05;
}

.upgradeButton:active {
    background-color: rgb(46, 99, 47);
    scale: 0.95;
}

.upgradeButton:disabled {
    background-color: rgb(64, 64, 64);
    color: rgb(180, 180, 180);
    opacity: 0.7;
}

.slotsContainer {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    flex-grow: 1;
    margin-top: 20px;
    padding: 15px;
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: center;
}

.slotContainer {
    width: 80px;
    height: 80px;
    margin: 5px;
    border-left-color: rgb(48, 48, 48);
    border-right-color: rgb(48, 48, 48);
    border-top-color: rgb(48, 48, 48);
    border-bottom-color: rgb(48, 48, 48);
    background-color: rgb(9, 19, 21);
    background-image: url('/Assets/WUG/Sprites/ItemSlotBackground.png');
    border-radius: 3px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5px;
}

.slotIcon {
    width: 50px;
    height: 50px;
    margin-bottom: 3px;
    flex-shrink: 0;
    flex-grow: 1;
    padding: 5px;
}

.slotName {
    font-size: 12px;
    color: white;
    font-weight: bold;
    -unity-text-align: middle-center;
}

.slotAmount {
    font-size: 10px;
    color: yellow;
    font-weight: normal;
    -unity-text-align: middle-center;
}

/* New upgrade panel styles */
.upgradePanel {
    position: absolute;
    width: 400px;
    background-color: rgb(28, 32, 36);
    border-top-color: rgb(255, 197, 0);
    border-top-width: 3px;
    padding: 15px;
    border-radius: 8px;
    display: none;
    flex-direction: column;
}

.upgradeHeader {
    font-size: 24px;
    color: rgb(255, 197, 0);
    border-bottom-color: rgb(64, 74, 82);
    border-bottom-width: 2px;
    margin-bottom: 10px;
    padding-bottom: 5px;
}

.upgradeOption {
    flex-direction: row;
    padding: 10px;
    margin: 5px 0;
    background-color: rgba(9, 19, 21, 0.7);
    border-radius: 5px;
    align-items: center;
}

.upgradeOptionIcon {
    width: 64px;
    height: 64px;
    background-color: rgba(48, 48, 48, 0.5);
    border-radius: 5px;
    margin-right: 10px;
}

.upgradeInfo {
    flex-grow: 1;
    flex-direction: column;
}

.upgradeTitle {
    font-size: 18px;
    color: rgb(255, 197, 0);
    margin-bottom: 5px;
}

.upgradeDescription {
    font-size: 14px;
    color: white;
    margin-bottom: 5px;
}

.resourceRequirement {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.resourceIcon {
    width: 20px;
    height: 20px;
    margin-right: 5px;
}

.resourceText {
    font-size: 12px;
    color: white;
}

.resourceAvailable {
    color: rgb(130, 255, 130);
}

.resourceMissing {
    color: rgb(255, 130, 130);
}

.upgradeOptionButton {
    background-color: rgb(47, 92, 48);
    border-radius: 5px;
    padding: 5px 10px;
    color: white;
    font-size: 14px;
    margin-left: 10px;
    align-self: center;
}

.closeButton {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 24px;
    height: 24px;
    background-color: rgba(255, 85, 85, 0.7);
    border-radius: 12px;
    color: white;
    -unity-text-align: middle-center;
    font-size: 14px;
}